; Pocket Oasis: original offline Android prototype. Open with Godot 4.3+.
config_version=5

[application]
config/name="واحة صغيرة | Pocket Oasis"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/description="An original, offline gathering, building and farming prototype."

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/handheld/orientation=0

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.66, 0.84, 0.87, 1)

[input_devices]
pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=false

[gui]
theme/default_font_multichannel_signed_distance_field=true

[physics]
common/physics_ticks_per_second=60
